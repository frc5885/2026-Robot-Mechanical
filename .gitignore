*.bak
*.old
*.tmp
*.log
*.err
*.ipj.old
*.ipt.old
*.iam.old
*.idw.old
*.dwg.old

# Inventor lock & temp
*.lck
*.tmp
~$*

# AutoCAD temporary & lock files
*.ac$
*.sv$
*.dwl
*.dwl2

# Vault local working folders
.vault/
.vaultcache/
.vaultworkspace/

# Autodesk Design Data (regenerated automatically)
Design Data/
**/Design Data/

# Content Center cache (large, auto-generated)
Content Center Files/
**/Content Center Files/

# Fusion / generic Autodesk exports
*.f3d.old
*.f2d.old


